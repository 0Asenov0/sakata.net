{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",   // ✅ crucial
    "strict": true,
    "noEmit": true,
    "types": ["vite/client", "jest"]
  },
  "include": ["src"]
}
